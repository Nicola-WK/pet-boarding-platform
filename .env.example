# Set these as process environment variables; Spring Boot does not load .env automatically.
DB_URL=jdbc:mysql://localhost:3306/pet_boarding?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=replace-me
DB_PASSWORD=replace-me
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET_BASE64=replace-with-base64-encoded-32-byte-random-secret
JWT_ISSUER=https://replace-with-your-api-domain.example
JWT_TTL=PT168H
WECHAT_APP_ID=replace-me
WECHAT_APP_SECRET=replace-me
